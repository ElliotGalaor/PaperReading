# Copier en .env et adapter.
PAPERSIM_DATABASE_URL=postgresql://papersim:papersim@localhost:5432/papersim

# Recommandé par OpenAlex (accès au "polite pool", plus rapide et plus stable).
PAPERSIM_OPENALEX_MAILTO=
# Optionnel, si vous avez une clé OpenAlex.
PAPERSIM_OPENALEX_API_KEY=

# Plafond de résultats par recherche arXiv (30000 au plus).
PAPERSIM_ARXIV_MAX_RESULTS=2000
# Cache arXiv (1 jour) et verrou partagé. Défaut : ~/.cache/papersim
# PAPERSIM_CACHE_DIR=

# Clé gratuite Semantic Scholar (formulaire : https://www.semanticscholar.org/product/api#api-key-form).
# Sans clé, l'API refuse très souvent les requêtes (erreur 429).
PAPERSIM_S2_API_KEY=

# local : SPECTER2 calculé sur cette machine (torch requis)
# s2    : vecteurs SPECTER2 téléchargés depuis Semantic Scholar (pas de GPU, clé S2 conseillée)
PAPERSIM_EMBEDDING_SOURCE=local

PAPERSIM_EMBEDDING_BASE=allenai/specter2_base
PAPERSIM_EMBEDDING_MODEL=allenai/specter2
PAPERSIM_EMBEDDING_DIM=768
PAPERSIM_EMBEDDING_BATCH_SIZE=16

# Comptes : inscription libre depuis la page de connexion (false : seulement papersim create-user).
PAPERSIM_ALLOW_SIGNUP=true
# Durée d'une session (jours) ; cookie réservé à HTTPS (true derrière un proxy HTTPS).
PAPERSIM_SESSION_DAYS=30
PAPERSIM_COOKIE_SECURE=false
